# Salin berkas ini menjadi .env.docker sebelum menjalankan Docker:
#   cp backend/.env.docker.example backend/.env.docker
# Berkas .env.docker TIDAK di-commit (ada di backend/.gitignore).

APP_NAME=Laravel
APP_ENV=production
# Kunci contoh untuk demo lokal. Ganti dengan hasil `php artisan key:generate --show`
# bila sistem ini dipakai di luar laptop sendiri.
APP_KEY=base64:BIZZkQ4iMZUh8pyrCwWev8EBRmB6M91bTJxFoTntcoI=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Masa berlaku token login (menit)
SANCTUM_EXPIRATION=10080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Di dalam Docker, nama layanan dipakai sebagai host (PRD §13.2)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=alfutuuhat
DB_USERNAME=alfutuuhat
DB_PASSWORD=rahasia

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Tanpa queue worker: event disiarkan langsung (ShouldBroadcastNow)
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Akun admin awal, dibuat oleh AdminSeeder
ADMIN_NAMA="Administrator Al-Futuuhat"
ADMIN_EMAIL=admin@alfutuuhat.test
ADMIN_PASSWORD=admin12345

# Reverb. Host `reverb` dipakai backend untuk menyiarkan event;
# peramban tetap memakai localhost:8080 (diatur di layanan frontend).
# REVERB_APP_KEY harus sama dengan NUXT_PUBLIC_REVERB_KEY di docker-compose.yml.
REVERB_APP_ID=100001
REVERB_APP_KEY=kunci-demo-alfutuuhat
REVERB_APP_SECRET=rahasia-demo-alfutuuhat
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Host frontend yang boleh tersambung ke Reverb, pisahkan dengan koma
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"