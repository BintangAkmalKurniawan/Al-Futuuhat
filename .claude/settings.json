{
  "permissions": {
    "allow": [
      "Bash(php artisan test *)",
      "Bash(php artisan route:list *)",
      "Bash(php artisan make:*)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(docker compose down -v *)",
      "Read(./backend/.env.docker)"
    ]
  }
}
